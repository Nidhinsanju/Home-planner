# Copy this file to .env and fill it in. .env is git-ignored: never commit your keys.

# ---- Database and login ------------------------------------------------------------------
# MongoDB connection string (local, or a MongoDB Atlas URI).
MONGODB_URI=
# Secret that signs login tokens: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SUPER_KEY=

# ---- AI (any OpenAI-compatible provider) -------------------------------------------------
# Your provider's API key. The provider's address is worked out from the key for
# OpenAI (sk-...), OpenRouter (sk-or-...), Anthropic (sk-ant-...) and Google Gemini (AIza...).
AI_API_KEY=
# The model to use, exactly as your provider names it. It should accept images: it reads
# uploaded floor plans. Examples: an OpenAI GPT model, a Claude model, a Gemini Flash model.
AI_MODEL=

# Optional: other models to try, in order, when AI_MODEL fails (busy, out of credit...).
AI_FALLBACK_MODELS=
# Optional: a different model just for reading floor-plan images (must accept images).
AI_VISION_MODEL=
# Optional: a stronger model that plans big requests ("design a 3BHK") as steps.
AI_PLANNER_MODEL=
AI_PLANNER_DAILY_LIMIT=20
# Optional: any other OpenAI-compatible provider (Together, Groq, DeepSeek, Mistral...) or a
# local server such as Ollama (http://localhost:11434/v1, no key needed) or LM Studio.
AI_BASE_URL=
# Optional: how the vision model gives positions: px, norm1000 (0-1000 grid), or auto.
AI_COORDINATES=auto

# ---- Limits ------------------------------------------------------------------------------
# AI prompts each account (and each device) may use in total. After that the AI is off and the
# plan can only be edited by hand. Admins have no limit.
AI_PROMPT_LIMIT=10
# Accounts that may be created on one device.
MAX_ACCOUNTS_PER_DEVICE=3
# Comma-separated emails of admin accounts (no AI prompt limit, no per-device limits).
ADMIN_EMAILS=
# AI requests each user may make per window (protects your key from runaway use).
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MIN=10
# Seconds to wait for an AI answer before trying the next model.
AI_TIMEOUT_SEC=120
# Output token limits (some providers reserve credit for the full amount).
AI_MAX_TOKENS=8000
EXTRACT_MAX_TOKENS=32000
# Reasoning effort when reading floor plans (low, medium, high, off); only sent to providers
# that support it.
EXTRACT_REASONING=medium
